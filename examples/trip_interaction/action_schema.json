              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "time_constraint_mode": {
            "enum": [
              null,
              "soft",
              "hard"
            ]
          },
          "pace": {
            "enum": [
              null,
              "quick",
              "standard",
              "deep"
            ]
