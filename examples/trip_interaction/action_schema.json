                "art",
                "bookish",
                "garden_culture",
                "gardens",
                "history",
                "iconic_landmark",
                "industrial_heritage",
                "industrial_transformation",
                "lane_life",
                "literary_shanghai",
                "literature",
                "local_atmosphere",
                "local_life",
                "modern_china_history",
                "modern_city",
                "modern_shanghai",
                "museum_visit",
                "music",
                "music_culture",
                "neighborhood_walk",
                "old_city",
                "parks",
                "photogenic",
                "political_history",
                "public_life",
                "quiet_walk",
                "religion",
                "religious_culture",
                "riverside_walk",
                "shikumen",
                "shopping_leisure",
                "shopping_lifestyle",
                "sino_foreign_exchange",
