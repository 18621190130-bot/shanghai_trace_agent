        "raw_provider_tags": {},
        "snippets": [
          {
            "text": "沈尹默故居是沿街三层两开间西式住宅，居门首挂有赵朴初题写的“沈尹默先生故居”匾额。底楼是陈列室、有沈尹默的半身塑像，橱里陈列着沈尹默先生生前眼镜、笔筒等遗物和书法集、诗词集、书法理论等。二楼是书房兼画室，陈列着沈尹默的书法精品。",
            "supports": [
              "history",
              "public_space",
              "access"
            ]
          }
        ],
        "supports": [
          "identity"
        ],
        "entity_kind": "unknown"
      },
